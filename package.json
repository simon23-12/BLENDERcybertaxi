{
  "name": "blendercybertaxi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CYBERTAXI - flying cab through a Blender-rendered cyberpunk megacity (three.js, iPhone tilt controls)",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=esm --target=safari15 --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --format=esm --target=safari15 --outfile=dist/game.js --watch & python3 -m http.server 8080",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": { "three": "0.186.1" },
  "devDependencies": { "esbuild": "^0.25.0" }
}
